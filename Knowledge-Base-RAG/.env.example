# Runtime mode
NODE_ENV=development

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Vector stores
PINECONE_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=

# App URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000

# Optional: choose how the web app calls backend
# mode=express -> apps/api
# mode=next-api -> Next.js API routes only
RAG_APP_MODE=express
