# =============================
# Core provider selection
# =============================
# Required: choose one of: openai, azure, anthropic, gemini, ollama, compatible
LLM_PROVIDER=openai
# Required: model used for chat/completions by your selected LLM provider
LLM_MODEL=gpt-4o-mini

# Required: choose one of: openai, azure, anthropic, gemini, ollama, compatible
EMBEDDING_PROVIDER=openai
# Required: model used for embeddings by your selected embedding provider
EMBEDDING_MODEL=text-embedding-3-small

# Required: choose one of: chroma, pinecone, qdrant, pgvector, supabase
VECTOR_DB_PROVIDER=chroma

# =============================
# OpenAI
# =============================
# Required when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
# Optional: defaults to https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional provider-specific override for chat model
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional provider-specific override for embedding model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================
# Azure OpenAI
# =============================
# Required when LLM_PROVIDER=azure or EMBEDDING_PROVIDER=azure
AZURE_OPENAI_API_KEY=
# Required: your Azure OpenAI resource endpoint (for example: https://<resource>.openai.azure.com)
AZURE_OPENAI_RESOURCE_URL=
# Optional: defaults to 2024-10-21
AZURE_OPENAI_API_VERSION=2024-10-21
# Required for chat with Azure deployment-based routing
AZURE_OPENAI_CHAT_DEPLOYMENT=
# Required for embeddings with Azure deployment-based routing
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# =============================
# Anthropic
# =============================
# Required when LLM_PROVIDER=anthropic or EMBEDDING_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional: defaults to https://api.anthropic.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Optional provider-specific override for chat model
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# =============================
# Gemini (Google)
# =============================
# Required when LLM_PROVIDER=gemini or EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: defaults to https://generativelanguage.googleapis.com/v1beta
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Optional provider-specific override for chat model
GEMINI_CHAT_MODEL=gemini-1.5-pro
# Optional provider-specific override for embedding model
GEMINI_EMBEDDING_MODEL=text-embedding-004

# =============================
# Ollama
# =============================
# Required when LLM_PROVIDER=ollama or EMBEDDING_PROVIDER=ollama
# (Ollama generally does not require an API key for local use.)
# Required: Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434
# Optional provider-specific override for chat model
OLLAMA_CHAT_MODEL=llama3.1
# Optional provider-specific override for embedding model
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =============================
# OpenAI-compatible provider
# =============================
# Required when LLM_PROVIDER=compatible or EMBEDDING_PROVIDER=compatible
# Optional: set if your compatible provider requires auth
COMPATIBLE_API_KEY=
# Required: base URL for the compatible API endpoint
COMPATIBLE_BASE_URL=
# Required when using compatible provider for chat
COMPATIBLE_CHAT_MODEL=
# Required when using compatible provider for embeddings
COMPATIBLE_EMBEDDING_MODEL=

# =============================
# Vector DB: Chroma
# =============================
# Required when VECTOR_DB_PROVIDER=chroma
CHROMA_URL=
# Optional: required only when your Chroma deployment uses token auth
CHROMA_TOKEN=

# =============================
# Vector DB: Pinecone
# =============================
# Required when VECTOR_DB_PROVIDER=pinecone
PINECONE_API_KEY=
# Required when VECTOR_DB_PROVIDER=pinecone
PINECONE_INDEX=
# Optional: set if your Pinecone setup requires explicit environment/host config
PINECONE_ENVIRONMENT=

# =============================
# Vector DB: Qdrant
# =============================
# Required when VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=
# Optional: required only when your Qdrant deployment requires API key auth
QDRANT_API_KEY=
# Required when VECTOR_DB_PROVIDER=qdrant
QDRANT_COLLECTION=

# =============================
# Vector DB: pgvector (Postgres)
# =============================
# Required when VECTOR_DB_PROVIDER=pgvector
PGVECTOR_CONNECTION_STRING=
# Required when VECTOR_DB_PROVIDER=pgvector
PGVECTOR_SCHEMA=public

# =============================
# Vector DB: Supabase
# =============================
# Required when VECTOR_DB_PROVIDER=supabase
SUPABASE_URL=
# Required when VECTOR_DB_PROVIDER=supabase
SUPABASE_KEY=
# Required when VECTOR_DB_PROVIDER=supabase
SUPABASE_SCHEMA=public
